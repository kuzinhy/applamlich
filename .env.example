# Sao chép file này thành `.env` rồi điền giá trị. `.env` đã nằm trong .gitignore và
# được `npm run dev` / `npm start` tự nạp (Node >= 20.12, cờ --env-file-if-exists).

# ---------------------------------------------------------------- AI (tuỳ chọn)
# Khoá Gemini dùng cho bóc tách văn bản và soạn lịch. Để trống thì mọi tính năng AI
# trả về 503 kèm hướng dẫn cấu hình — hệ thống không tự bịa dữ liệu mẫu.
# Các chức năng còn lại (lịch tuần, xung đột, thể thức, xuất file) vẫn chạy đầy đủ.
GEMINI_API_KEY=

# Tên model Gemini đang được hỗ trợ. Xem danh sách hiện hành tại
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.8-flash

# Số lần thử khi mô hình trả lỗi; lần cuối sẽ cố sửa JSON ở nhiệt độ 0 trước khi bỏ.
GEMINI_MAX_ATTEMPTS=3
LLM_MAX_ATTEMPTS=3

# auto (mặc định): dùng provider khả dụng đầu tiên; hoặc ép gemini | ollama | openai.
LLM_PROVIDER=auto

# Ollama cục bộ — chạy hoàn toàn offline, dữ liệu không rời máy.
# Cài Ollama rồi: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_DISABLED=1
# OLLAMA_ENABLED=1   # đặt 1 để luôn thử Ollama trong chế độ auto

# API OpenAI-compatible (Groq, OpenRouter, LM Studio…). Phải đặt cả base URL và khoá.
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------- Máy chủ
# Mặc định chỉ nghe trên chính máy này. Ứng dụng đã có tài khoản đăng nhập, nên muốn
# cho các máy khác truy cập thì đặt HOST=0.0.0.0 và chạy sau một lớp HTTPS (nginx/Caddy).
HOST=127.0.0.1
PORT=3000

# Đặt production để server phục vụ bản build trong dist/ thay vì Vite dev server.
# NODE_ENV=production

# Thư mục chứa kho dữ liệu (app_store.json, backups, drive_incoming). Mặc định ./data
# trong thư mục dự án; đặt ra ngoài mã nguồn khi deploy để không bị ghi đè khi cập nhật.
# APP_DATA_DIR=/duong/dan/rieng/du-lieu

# ---------------------------------------------------------------- Đăng nhập & phân quyền
# Mật khẩu mặc định của 3 tài khoản tích hợp sẵn theo 3 cấp quyền:
# - admin   (Quản trị viên — toàn quyền)
# - bientap (Biên tập viên — soạn, duyệt đề xuất, ban hành lịch)
# - xemlich (Người xem — chỉ xem & in lịch)
DEFAULT_ADMIN_PASSWORD=admin
DEFAULT_EDITOR_PASSWORD=bientap
DEFAULT_VIEWER_PASSWORD=xemlich

# Danh sách tài khoản bổ sung cố định từ .env (phân tách bằng dấu ; theo cú pháp username:password:role:Họ tên).
# Hữu ích khi triển khai trên Vercel mà muốn cấp tài khoản riêng cố định cho nhiều cán bộ:
# APP_USERS=vanphong:vp1234:editor:Văn phòng Đảng ủy;tonghop:th1234:viewer:Tổ Tổng hợp

# Mã khôi phục khẩn cấp (tuỳ chọn) cho phép đặt lại mật khẩu bất kỳ tài khoản nào
# ngay tại màn hình "Quên mật khẩu / Khôi phục tài khoản" mà không cần xoá app_store.json.
# ADMIN_RESET_CODE=

# Số ngày một phiên đăng nhập còn hiệu lực (mặc định 7).
SESSION_TTL_DAYS=7

# Mật khẩu tối thiểu khi tạo mới / đổi mật khẩu (mặc định 10). Vẫn bắt buộc có chữ và số, không trùng tên đăng nhập.
PASSWORD_MIN_LENGTH=10

# Số lần đăng nhập sai liên tiếp trước khi tạm khoá, và số phút khoá (tăng gấp đôi mỗi lần).
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15

# auto (mặc định): cookie chỉ gắn cờ Secure khi yêu đến qua HTTPS; always: buộc Secure, kể cả khi
# truy cập http://127.0.0.1 (lưu ý: trình duyệt sẽ KHÔNG gửi lại cookie đó trên http); never: bỏ Secure.
# Ở chế độ production, đăng nhập qua HTTP sẽ bị từ chối (HTTPS_REQUIRED) trừ khi đặt never khi thử máy.
COOKIE_SECURE=auto

# Đặt 1 khi chạy sau reverse proxy (nginx/Caddy) để server đọc IP thật và biết request đi qua
# HTTPS hay không từ X-Forwarded-For / X-Forwarded-Proto. Để 0 khi không có proxy — nếu không,
# người dùng giả mạo được các header này.
TRUST_PROXY=0

# ------------------------------------------------------ Đăng nhập bằng Google
# OAuth client ID loại "Web application" (chuỗi công khai, KHÔNG phải client secret). Tạo tại
# https://console.cloud.google.com/apis/credentials ; thêm origin của app vào "Authorized
# JavaScript origins" (vd http://localhost:3000 và https://domain-cua-ban).
# Khi cấu hình Client ID, ứng dụng sử dụng đăng nhập Google thay cho mật khẩu.
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# Giới hạn miền Google Workspace (phân cách bởi dấu phẩy). Gmail cá nhân sẽ bị chặn khi cấu hình giới hạn miền
# được nếu để trống biến này. Đặt giá trị khi chỉ muốn người dùng của cơ quan.
# GOOGLE_ALLOWED_DOMAINS=phuongthudauone.hochiminh.gov.vn

# Vai trò gán cho tài khoản tự tạo ở lần đăng nhập Google đầu tiên: admin | editor | viewer.
# Mặc định viewer — quản trị viên nâng quyền sau trong màn Tài khoản.
# GOOGLE_SIGNUP_ROLE=viewer

# ---------------------------------------------------------------- Firebase (tuỳ chọn, cho "Bộ não tri thức")
# Cách 1: đặt các biến dưới đây (frontend nạp trực tiếp, không cần tệp cấu hình).
# Cách 2: sao chép firebase-applet-config.example.json thành firebase-applet-config.json
# ở thư mục dự án — tệp đó đã nằm ngoài git, server phát cho frontend qua /api/config/firebase.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=

# ---------------------------------------------------------------- Nạp tệp & OCR
# Giới hạn dung lượng tệp sau khi giải base64 (MB). Route nạp tệp tự nới body JSON theo giá trị này.
MAX_UPLOAD_MB=20

# Số trang PDF scan tối đa được render + OCR mỗi tệp (mặc định 10).
PDF_OCR_MAX_PAGES=10
# Đặt 1 để tắt OCR, chỉ đọc lớp chữ của PDF.
# PDF_OCR_DISABLED=1

# Font cho xuất PDF (mặc định tự dò theo họ, ưu tiên serif đúng thể thức văn bản:
# Times New Roman → Liberation Serif → DejaVu Serif → Arial/Segoe UI).
# Windows/macOS thường tự dò được; Linux thiếu serif thì trỏ tới phông .ttf bất kỳ:
# PDF_FONT_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# PDF_FONT_BOLD_PATH=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# ---------------------------------------------------------------- Giới hạn thao tác
# Số lần gọi AI mỗi phút cho mỗi tài khoản (route /ai/*, phân tích tệp, gợi ý xung đột).
RATE_AI_PER_MIN=30
# Số lần nạp tệp mỗi giờ cho mỗi tài khoản.
RATE_UPLOAD_PER_HOUR=120

# ---------------------------------------------------------------- Nhắc việc (tuỳ chọn)
# Đặt 0 để tắt scheduler gửi bản tin/nhắc việc trong tiến trình server.
# NOTIFY_SCHEDULER=0
# Cấu hình Telegram/SMTP thực hiện trong giao diện Cài đặt, không cần đặt trong .env.

# ---------------------------------------------------------------- Webhook xuất (tuỳ chọn)
# Thời gian chờ tối đa mỗi lần gọi URL nhận (Google Apps Script / n8n). Mặc định 8000 ms.
WEBHOOK_TIMEOUT_MS=8000

# Gmail quản trị (phân cách bằng dấu phẩy). Cấu hình trước lần đăng nhập đầu tiên.
# GOOGLE_ADMIN_EMAILS=your-name@gmail.com

# ---------------------------------------------------------------- Đồng bộ đa nền tảng (Firestore)
# Để mọi máy chủ/trình duyệt thấy cùng MỘT nội dung, kho dữ liệu chuyển sang Firestore.
# Không đặt hai biến này thì app vẫn chạy bình thường bằng file data/app_store.json.
# FIREBASE_PROJECT_ID=applamlich-tuyengiao-xxxxx
# Đường dẫn file key của service account (KHÔNG commit file này), hoặc JSON inline.
# GOOGLE_APPLICATION_CREDENTIALS=C:/Users/<ban>/.config/applamlich-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Tên document chứa state của cơ quan. Hai đơn vị dùng chung project thì đặt khác nhau.
# SYNC_DOC_KEY=co-quan
# instance serverless chờ kéo cloud tối đa bao nhiêu mili-giây trước khi phục vụ bằng cache.
# CLOUD_BOOTSTRAP_TIMEOUT_MS=2500

# ---------------------------------------------------------------- Kho chung Google Sheet (tuỳ chọn)
# Lịch đã duyệt/ban hành tự đẩy lên một tab sheet để cán bộ cùng sửa; sửa trên sheet được kéo về app.
# Tắt mặc định: không đặt gì thì app chỉ dùng file/Firestore như trước.
# Bật trong Giao diện > Cài đặt > "Kho chung Google Sheet" (dán đường dẫn https://docs.google.com/spreadsheets/d/...).
# Kho service account: dùng chung một tài khoản với Firestore ở trên cũng được, hoặc tạo riêng.
# GOOGLE_SHEETS_CREDENTIALS=C:/Users/<ban>/.config/applamlich-service-account.json
# GOOGLE_SHEETS_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# QUAN TRỌNG: dán khoá vào đây, KHÔNG dán lên màn hình Cài đặt và KHÔNG commit file key.
# Phải chia sẻ sheet cho email client_email trong khoá với quyền Editor; app không tự đổi quyền chia sẻ.
# Hai biến dưới đây chỉ dành cho kiểm thử (hướng luồng gọi sang máy chủ Google giả):
# GOOGLE_SHEETS_TOKEN_URL=
# GOOGLE_SHEETS_API_BASE=
